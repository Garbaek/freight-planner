<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mfd_background">

    <ScrollView
        android:id="@+id/accountPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="18dp"
                android:layout_weight="1.15"
                android:background="@drawable/mfd_panel"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:text="FC // LOGISTICS TERMINAL"
                    android:textColor="#65D8DE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="FREIGHT\nPLANNER"
                    android:textColor="#EAF7F5"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="96dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="14dp"
                    android:background="#E6C879" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="5dp"
                    android:text="ROUTE OPTIMIZATION     ONLINE\nMANIFEST LINK         STANDBY\nLOCAL OCR             READY\nGAME INPUT            DISABLED"
                    android:textColor="#8FB1B6"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="A dedicated manifest display for flight plans, loading order, pickups, and deliveries."
                    android:textColor="#C8D8DA"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:background="@drawable/mfd_panel_bright"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:text="SECURE CREW ACCESS"
                    android:textColor="#E6C879"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/serverUrl"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/mfd_input"
                    android:fontFamily="monospace"
                    android:hint="SERVER ENDPOINT"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="#EAF7F5"
                    android:textColorHint="#597B82"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/displayName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="name"
                    android:background="@drawable/mfd_input"
                    android:fontFamily="monospace"
                    android:hint="DISPLAY NAME"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:textColor="#EAF7F5"
                    android:textColorHint="#597B82"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/mfd_input"
                    android:fontFamily="monospace"
                    android:hint="ACCOUNT EMAIL"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="#EAF7F5"
                    android:textColorHint="#597B82"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:autofillHints="password"
                    android:background="@drawable/mfd_input"
                    android:fontFamily="monospace"
                    android:hint="PASSWORD"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#EAF7F5"
                    android:textColorHint="#597B82"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:minHeight="20dp"
                    android:textColor="#FF998D"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/submit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/mfd_button"
                        android:fontFamily="sans-serif-condensed"
                        android:stateListAnimator="@null"
                        android:text="SIGN IN"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/switchMode"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/mfd_button_outline"
                        android:fontFamily="sans-serif-condensed"
                        android:stateListAnimator="@null"
                        android:text="CREATE ACCOUNT"
                        android:textColor="#C8D8DA" />
                </LinearLayout>

                <Button
                    android:id="@+id/resendVerification"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mfd_button_outline"
                    android:fontFamily="monospace"
                    android:stateListAnimator="@null"
                    android:text="RESEND VERIFICATION EMAIL"
                    android:textColor="#E6C879"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/scanQrLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mfd_button"
                    android:fontFamily="sans-serif-condensed"
                    android:stateListAnimator="@null"
                    android:text="SCAN PC QR CODE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/demoMode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mfd_button_outline"
                    android:fontFamily="monospace"
                    android:stateListAnimator="@null"
                    android:text="OPEN OFFLINE DISPLAY DEMO"
                    android:textColor="#8FB1B6"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/shareUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:buttonTint="#65D8DE"
                    android:fontFamily="monospace"
                    android:text="SHARE ANONYMOUS LAUNCH COUNT\nPLATFORM + VERSION ONLY"
                    android:textColor="#8FB1B6"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/signOut"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/cockpitPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mfd_background"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:letterSpacing="0.12"
            android:text="FC-04  //  CARGO OPERATIONS NETWORK  //  LOCAL PLAN TELEMETRY"
            android:textColor="#66878D"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/mfd_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.12"
                    android:text="FREIGHT PLANNER"
                    android:textColor="#EAF7F5"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ACTIVE ROUTE / LOAD MANIFEST"
                    android:textColor="#E6C879"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="● LINK STANDBY"
                android:textColor="#65D8DE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/relinkPc"
                android:layout_width="118dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/mfd_button_outline"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="RELINK PC"
                android:textColor="#65D8DE"
                android:textSize="10sp" />

            <Button
                android:id="@+id/leaveCockpit"
                android:layout_width="132dp"
                android:layout_height="42dp"
                android:background="@drawable/mfd_button_outline"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="CREW ACCOUNT"
                android:textColor="#C8D8DA"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pairingPanel"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/mfd_panel_bright"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="PC TELEMETRY LINK REQUIRED"
                    android:textColor="#E6C879"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pairingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Choose Pair phone in the Windows client, then scan its QR code or enter the six-digit code."
                    android:textColor="#AFC4C7"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/scanQrPair"
                android:layout_width="118dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/mfd_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="SCAN QR"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/pairingCode"
                android:layout_width="190dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/mfd_input"
                android:digits="0123456789"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="000000"
                android:importantForAutofill="no"
                android:inputType="number"
                android:letterSpacing="0.25"
                android:maxLength="6"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#597B82"
                android:textSize="18sp" />

            <Button
                android:id="@+id/pairPc"
                android:layout_width="142dp"
                android:layout_height="44dp"
                android:background="@drawable/mfd_button"
                android:fontFamily="monospace"
                android:stateListAnimator="@null"
                android:text="ESTABLISH LINK"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/mfd_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <View
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:background="#E6C879" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/planTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="NO ACTIVE FLIGHT PLAN"
                    android:textColor="#F3EBC9"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/planSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="PAIR WITH THE WINDOWS CLIENT TO RECEIVE ROUTE TELEMETRY"
                    android:textColor="#8FB1B6"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="DISPLAY MODE\nNO GAME INPUT"
                android:textColor="#66878D"
                android:textSize="9sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/planEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/mfd_panel"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="AWAITING ROUTE DATA\n\nPACKING ORDER  //  PICKUPS  //  DELIVERIES"
                    android:textColor="#597B82"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/planStops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
