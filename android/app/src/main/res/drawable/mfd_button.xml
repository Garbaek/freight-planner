<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2B6970" />
            <stroke android:width="1dp" android:color="#A8F5F3" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1C4C53" android:endColor="#12343A" />
            <stroke android:width="1dp" android:color="#65D8DE" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
